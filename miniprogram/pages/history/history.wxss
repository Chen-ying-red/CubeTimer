/* pages/history/history.wxss */
.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.stats-card {
  margin-bottom: 24rpx;
}

.stats-row {
  display: flex;
  justify-content: space-around;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-label {
  font-size: 22rpx;
  opacity: 0.7;
  margin-bottom: 8rpx;
}

.stats-val {
  font-size: 36rpx;
  font-weight: bold;
}

.pb-text {
  color: #3b82f6;
}

.stats-divider {
  height: 1rpx;
  background-color: rgba(255, 255, 255, 0.1);
  margin: 20rpx 0;
}

.sync-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background-color: rgba(59, 130, 246, 0.12);
  border: 1rpx solid rgba(59, 130, 246, 0.25);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
}

.sync-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.sync-text {
  font-size: 22rpx;
  color: #3b82f6;
  font-weight: 500;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.list-title {
  font-size: 28rpx;
  font-weight: bold;
}

.clear-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.trash-icon {
  width: 28rpx;
  height: 28rpx;
}

.clear-text {
  font-size: 24rpx;
  color: #ef4444;
}

.history-scroll {
  flex: 1;
  overflow: hidden;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  font-size: 26rpx;
  opacity: 0.6;
}

.solve-card {
  margin-bottom: 16rpx;
  padding: 20rpx 24rpx;
}

.solve-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.solve-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.solve-index {
  font-size: 24rpx;
  opacity: 0.6;
  font-weight: bold;
}

.solve-puzzle {
  font-size: 24rpx;
  background-color: rgba(255, 255, 255, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.solve-time {
  font-size: 32rpx;
  font-weight: bold;
}

.solve-details {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.scramble-preview {
  font-size: 20rpx;
  opacity: 0.6;
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-right: 16rpx;
}

.delete-btn {
  font-size: 22rpx;
  color: #ef4444;
  padding: 4rpx 12rpx;
}
