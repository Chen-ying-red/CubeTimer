/* pages/history/history.wxss */
.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background-color: #121212;
  color: #ffffff;
}

.theme-light {
  background-color: #ffffff;
  color: #111827;
}

.stats-card {
  margin-bottom: 24rpx;
  background-color: #1c1c1e;
}

.theme-light .stats-card {
  background-color: #f9fafb;
}

.stats-row {
  display: flex;
  justify-content: space-around;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-label {
  font-size: 22rpx;
  color: #9ca3af;
  margin-bottom: 8rpx;
}

.stats-val {
  font-size: 36rpx;
  font-weight: bold;
}

.pb-text {
  color: #3b82f6;
}

.stats-divider {
  height: 1rpx;
  background-color: #2c2c2e;
  margin: 20rpx 0;
}

.theme-light .stats-divider {
  background-color: #e5e7eb;
}

.sync-banner {
  display: flex;
  align-items: center;
  background-color: rgba(59, 130, 246, 0.1);
  border: 1rpx solid rgba(59, 130, 246, 0.2);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
}

.sync-icon {
  font-size: 28rpx;
  color: #3b82f6;
  margin-right: 12rpx;
}

.sync-text {
  font-size: 22rpx;
  color: #3b82f6;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.list-title {
  font-size: 28rpx;
  font-weight: bold;
}

.clear-btn {
  font-size: 24rpx;
  color: #ef4444;
}

.history-scroll {
  flex: 1;
  overflow: hidden;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  font-size: 26rpx;
  color: #6b7280;
}

.solve-card {
  margin-bottom: 16rpx;
  padding: 20rpx 24rpx;
}

.solve-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.solve-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.solve-index {
  font-size: 24rpx;
  color: #9ca3af;
  font-weight: bold;
}

.solve-puzzle {
  font-size: 24rpx;
  background-color: #2c2c2e;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  color: #d1d5db;
}

.theme-light .solve-puzzle {
  background-color: #e5e7eb;
  color: #374151;
}

.solve-time {
  font-size: 32rpx;
  font-weight: bold;
}

.solve-details {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.scramble-preview {
  font-size: 20rpx;
  color: #6b7280;
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-right: 16rpx;
}

.delete-btn {
  font-size: 22rpx;
  color: #ef4444;
  padding: 4rpx 12rpx;
}
