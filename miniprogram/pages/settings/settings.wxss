/* pages/settings/settings.wxss */
.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background-color: #121212;
  color: #ffffff;
}

.theme-light {
  background-color: #ffffff;
  color: #111827;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
  margin-left: 8rpx;
}

.setting-card {
  margin-bottom: 24rpx;
  padding: 24rpx 32rpx;
  background-color: #1c1c1e;
}

.theme-light .setting-card {
  background-color: #f9fafb;
}

.card-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.card-icon {
  font-size: 32rpx;
  color: #3b82f6;
  margin-right: 12rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: bold;
}

.cloud-tip {
  font-size: 24rpx;
  color: #9ca3af;
  line-height: 1.6;
  margin-bottom: 24rpx;
  display: block;
}

.btn-sync {
  background-color: #3b82f6;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: bold;
  border-radius: 16rpx;
  padding: 14rpx 0;
  width: 100%;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.item-left {
  display: flex;
  flex-direction: column;
}

.item-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.item-desc {
  font-size: 22rpx;
  color: #9ca3af;
}

.item-picker {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #3b82f6;
  font-weight: bold;
}

.arrow {
  font-size: 28rpx;
  color: #9ca3af;
  margin-left: 8rpx;
}

.item-divider {
  height: 1rpx;
  background-color: #2c2c2e;
  margin: 16rpx 0;
}

.theme-light .item-divider {
  background-color: #e5e7eb;
}

.about-card {
  margin-top: auto;
  margin-bottom: 24rpx;
  text-align: center;
  background-color: #1c1c1e;
}

.theme-light .about-card {
  background-color: #f9fafb;
}

.about-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #3b82f6;
  margin-bottom: 12rpx;
  display: block;
}

.about-desc {
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.5;
  display: block;
}
