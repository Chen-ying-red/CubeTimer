<!-- pages/timer/timer.wxml -->
<view class="page-container {{themeClass}}">
  
  <!-- 1. 顶部控制栏 (魔方类型选择器 & 打乱刷新) -->
  <view class="top-bar {{appState === 'RUNNING' ? 'fade-out' : ''}}">
    <picker bindchange="onPuzzleChange" value="{{puzzleIndex}}" range="{{puzzleList}}">
      <view class="puzzle-picker">
        <svg class="icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
          <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
          <line x1="12" y1="22.08" x2="12" y2="12"></line>
        </svg>
        <text class="puzzle-title">{{puzzleList[puzzleIndex]}}</text>
        <svg class="icon-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </view>
    </picker>

    <view class="refresh-btn" bindtap="refreshScramble">
      <svg class="icon-refresh" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <polyline points="23 4 23 10 17 10"></polyline>
        <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
      </svg>
      <text class="refresh-text">刷新打乱</text>
    </view>
  </view>

  <!-- 2. WCA 打乱展示区 -->
  <view class="scramble-box {{appState === 'RUNNING' ? 'fade-out' : ''}}" bindtap="refreshScramble">
    <text class="scramble-text">{{scrambleText}}</text>
  </view>

  <!-- 3. 主计时触控面板 -->
  <view 
    class="timer-touch-area" 
    bindtouchstart="onTouchStart" 
    bindtouchend="onTouchEnd"
  >
    <view class="timer-display-box">
      <text class="timer-display timer-font {{timerClass}}">{{displayTime}}</text>
    </view>

    <view class="instruction-text {{appState === 'RUNNING' ? 'fade-out' : ''}}">
      <text wx:if="{{appState === 'IDLE'}}">长按屏幕就绪，松开开启计时</text>
      <text wx:elif="{{appState === 'HOLDING'}}">保持按住...</text>
      <text wx:elif="{{appState === 'READY'}}">松手开始计时！</text>
      <text wx:elif="{{appState === 'RUNNING'}}">点击屏幕停止计时</text>
    </view>
  </view>

  <!-- 4. 成绩结算 Modal 弹窗 -->
  <view class="modal-mask" wx:if="{{showModal}}">
    <view class="modal-box card-box">
      <text class="modal-subtitle">本次成绩结算</text>
      <text class="modal-time timer-font">{{modalTimeDisplay}}</text>

      <view class="modal-actions">
        <button class="btn-modal btn-ok" bindtap="confirmPenalty" data-penalty="OK">保留 (OK)</button>
        <view class="modal-row">
          <button class="btn-modal btn-p2" bindtap="confirmPenalty" data-penalty="+2">+2 秒</button>
          <button class="btn-modal btn-dnf" bindtap="confirmPenalty" data-penalty="DNF">DNF 废弃</button>
        </view>
      </view>
    </view>
  </view>

</view>
