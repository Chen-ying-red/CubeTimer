/* pages/timer/timer.wxss */
.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  width: 100%;
  background-color: #121212;
  color: #ffffff;
  position: relative;
  overflow: hidden;
}

.theme-light {
  background-color: #ffffff;
  color: #111827;
}

.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  z-index: 10;
  transition: opacity 0.2s;
}

.puzzle-picker {
  display: flex;
  align-items: center;
  background-color: #1c1c1e;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid #2c2c2e;
}

.theme-light .puzzle-picker {
  background-color: #f3f4f6;
  border-color: #e5e7eb;
}

.puzzle-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-right: 12rpx;
}

.picker-icon {
  font-size: 20rpx;
  color: #9ca3af;
}

.refresh-btn {
  font-size: 26rpx;
  color: #3b82f6;
  padding: 12rpx 20rpx;
  font-weight: bold;
}

.scramble-box {
  padding: 16rpx 32rpx;
  text-align: center;
  z-index: 10;
  min-height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.2s;
}

.scramble-text {
  font-size: 32rpx;
  line-height: 1.5;
  color: #d1d5db;
  font-weight: 500;
  word-break: break-all;
}

.theme-light .scramble-text {
  color: #4b5563;
}

.timer-touch-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 100%;
  z-index: 5;
}

.timer-display-box {
  display: flex;
  justify-content: center;
  align-items: center;
}

.timer-display {
  font-size: 130rpx;
  font-weight: 800;
  letter-spacing: -2rpx;
}

.timer-idle {
  color: #ffffff;
}

.theme-light .timer-idle {
  color: #111827;
}

.timer-holding {
  color: #ef4444 !important;
}

.timer-ready {
  color: #22c55e !important;
}

.timer-running {
  color: #3b82f6 !important;
}

.instruction-text {
  margin-top: 40rpx;
  font-size: 24rpx;
  color: #6b7280;
  transition: opacity 0.2s;
}

.fade-out {
  opacity: 0;
  pointer-events: none;
}

/* Modal 结算弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.7);
  z-index: 100;
  display: flex;
  justify-content: center;
  align-items: center;
}

.modal-box {
  width: 560rpx;
  background-color: #1c1c1e;
  border: 1rpx solid #2c2c2e;
  border-radius: 36rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.5);
}

.theme-light .modal-box {
  background-color: #ffffff;
  border-color: #e5e7eb;
}

.modal-subtitle {
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 12rpx;
}

.modal-time {
  font-size: 72rpx;
  font-weight: bold;
  margin-bottom: 32rpx;
}

.modal-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.modal-row {
  display: flex;
  gap: 16rpx;
  width: 100%;
}

.btn-modal {
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #ffffff;
  padding: 20rpx 0;
  width: 100%;
}

.btn-ok {
  background-color: #22c55e;
}

.btn-p2 {
  flex: 1;
  background-color: #f59e0b;
}

.btn-dnf {
  flex: 1;
  background-color: #ef4444;
}
