/* pages/timer/timer.wxss */
.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  width: 100%;
  position: relative;
  overflow: hidden;
}

.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  z-index: 10;
  transition: opacity 0.2s;
}

.puzzle-picker {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background-color: rgba(255, 255, 255, 0.08);
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.icon-svg {
  color: #3b82f6;
}

.puzzle-title {
  font-size: 28rpx;
  font-weight: bold;
}

.icon-arrow {
  color: #9ca3af;
}

.refresh-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #3b82f6;
  padding: 12rpx 20rpx;
  font-weight: bold;
}

.icon-refresh {
  color: #3b82f6;
}

.refresh-text {
  font-size: 26rpx;
}

.scramble-box {
  padding: 16rpx 32rpx;
  text-align: center;
  z-index: 10;
  min-height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.2s;
}

.scramble-text {
  font-size: 32rpx;
  line-height: 1.5;
  font-weight: 500;
  word-break: break-all;
}

.timer-touch-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 100%;
  z-index: 5;
}

.timer-display-box {
  display: flex;
  justify-content: center;
  align-items: center;
}

.timer-display {
  font-size: 130rpx;
  font-weight: 800;
  letter-spacing: -2rpx;
}

.timer-holding {
  color: #ef4444 !important;
}

.timer-ready {
  color: #22c55e !important;
}

.timer-running {
  color: #3b82f6 !important;
}

.instruction-text {
  margin-top: 40rpx;
  font-size: 24rpx;
  opacity: 0.7;
  transition: opacity 0.2s;
}

.fade-out {
  opacity: 0;
  pointer-events: none;
}

/* Modal 结算弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.75);
  z-index: 100;
  display: flex;
  justify-content: center;
  align-items: center;
}

.modal-box {
  width: 560rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.5);
}

.modal-subtitle {
  font-size: 24rpx;
  opacity: 0.7;
  margin-bottom: 12rpx;
}

.modal-time {
  font-size: 72rpx;
  font-weight: bold;
  margin-bottom: 32rpx;
}

.modal-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.modal-row {
  display: flex;
  gap: 16rpx;
  width: 100%;
}

.btn-modal {
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #ffffff;
  padding: 20rpx 0;
  width: 100%;
}

.btn-ok { background-color: #22c55e; }
.btn-p2 { flex: 1; background-color: #f59e0b; }
.btn-dnf { flex: 1; background-color: #ef4444; }
