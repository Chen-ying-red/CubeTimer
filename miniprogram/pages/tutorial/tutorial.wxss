/* pages/tutorial/tutorial.wxss */
.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background-color: #121212;
  color: #ffffff;
}

.theme-light {
  background-color: #ffffff;
  color: #111827;
}

/* 胶囊 Segmented Tab */
.segmented-control {
  display: flex;
  background-color: #1c1c1e;
  padding: 6rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.theme-light .segmented-control {
  background-color: #f3f4f6;
}

.segment-btn {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  font-weight: bold;
  padding: 14rpx 0;
  color: #9ca3af;
  border-radius: 16rpx;
  transition: all 0.2s;
}

.segment-btn.active {
  background-color: #2c2c2e;
  color: #3b82f6;
}

.theme-light .segment-btn.active {
  background-color: #ffffff;
  color: #3b82f6;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 搜索框 */
.search-bar {
  margin-bottom: 20rpx;
}

.search-input {
  background-color: #1c1c1e;
  border: 1rpx solid #2c2c2e;
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  color: #ffffff;
}

.theme-light .search-input {
  background-color: #f9fafb;
  border-color: #e5e7eb;
  color: #111827;
}

/* 滚动内容区 */
.tutorial-scroll {
  flex: 1;
  overflow: hidden;
}

/* Cross 卡片 */
.cross-card {
  display: flex;
  flex-direction: column;
}

.cross-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #3b82f6;
  margin-bottom: 16rpx;
}

.cross-concept {
  font-size: 26rpx;
  line-height: 1.6;
  color: #9ca3af;
  margin-bottom: 24rpx;
}

.cross-subtitle {
  font-size: 26rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.cross-step-item {
  margin-bottom: 16rpx;
}

.step-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: #d1d5db;
}

.theme-light .step-text {
  color: #4b5563;
}

/* 公式分组与卡片 */
.group-section {
  margin-bottom: 24rpx;
}

.group-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.group-icon {
  font-size: 24rpx;
  color: #3b82f6;
  margin-right: 12rpx;
}

.group-name {
  font-size: 28rpx;
  font-weight: bold;
}

.formula-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.formula-card {
  padding: 20rpx 24rpx;
  background-color: #1c1c1e;
}

.theme-light .formula-card {
  background-color: #f9fafb;
}

.card-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.badge {
  font-size: 18rpx;
  font-weight: 800;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  color: #ffffff;
  text-transform: uppercase;
}

.badge-f2l { background-color: #10b981; }
.badge-oll { background-color: #f59e0b; }
.badge-pll { background-color: #ef4444; }

.formula-name {
  font-size: 26rpx;
  font-weight: bold;
}

.formula-body {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #2c2c2e;
  border-radius: 16rpx;
  padding: 12rpx 20rpx;
}

.theme-light .formula-body {
  background-color: #e5e7eb;
}

.formula-code {
  font-size: 26rpx;
  color: #3b82f6;
  font-weight: bold;
  flex: 1;
  word-break: break-all;
  margin-right: 16rpx;
}

.copy-btn {
  background-color: #3b82f6;
  padding: 6rpx 20rpx;
  border-radius: 12rpx;
}

.copy-text {
  font-size: 22rpx;
  color: #ffffff;
  font-weight: bold;
}

.empty-search {
  text-align: center;
  padding: 80rpx 0;
  color: #6b7280;
  font-size: 26rpx;
}
